<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <runtime>
    <!--
      REQ-NFR-001: a 30-second capture at 25.6 MS/s of Complex32 is 6.1 GB, so the default
      2 GB single-array ceiling is reached by one long recording.

      Ceiling to design around even with this enabled: the maximum element count for a
      non-byte array remains 2,146,435,071 (0x7FEFFFFF), so a single float[] holds at most
      ~1.07 G complex samples (~8.6 GB). Captures above that MUST be chunked across multiple
      arrays — this switch raises the ceiling, it does not remove it.
    -->
    <gcAllowVeryLargeObjects enabled="true" />

    <!-- Server GC suits the bounded-allocation DSP pipeline of REQ-NFR-002. -->
    <gcServer enabled="true" />
    <gcConcurrent enabled="true" />
  </runtime>

  <appSettings>
    <!--
      REQ-NFR-007: per-monitor DPI awareness V1. WPF on .NET Framework supports PMv1 from
      4.6.2 via app.manifest plus this switch. Do NOT declare PerMonitorV2 on this stack —
      WPF on .NET Framework does not implement its behaviours; that arrived with .NET Core 3.0.
    -->
    <add key="Switch.System.Windows.DoNotScaleForDpiChanges" value="false" />
  </appSettings>

</configuration>
