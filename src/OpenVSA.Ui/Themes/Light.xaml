<!--
    The Light chrome theme (REQ-UI-083).

    Chrome only; see Dark.xaml for why, and for the rule that every key of ChromeKeys.All appears in
    both files. Switching to this theme leaves the graticule dark, and that is REQ-UI-081 rather
    than an oversight: the plot surface is governed by the colour settings of REQ-UI-022, which a
    theme does not touch. A user wanting a light graticule sets one in Display Preferences ▸ Colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="OpenVSA.Chrome.WindowBackground" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.WindowForeground" Color="#FF1A1A1E" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.SurfaceBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.SurfaceForeground" Color="#FF1A1A1E" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.MutedForeground" Color="#FF5F5F6B" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.DisabledForeground" Color="#FF9A9AA4" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.Border" Color="#FFD0D0D8" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.MenuBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.MenuForeground" Color="#FF1A1A1E" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.ToolbarBackground" Color="#FFF7F7F9" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.StatusBarBackground" Color="#FFECECF0" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.StatusBarForeground" Color="#FF3A3A44" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.SelectionBackground" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.SelectionForeground" Color="#FF1A1A1E" />

    <SolidColorBrush x:Key="OpenVSA.Chrome.Accent" Color="#FF1E70BE" />

    <!--
        The overlay stays dark under a light chrome: it is drawn over the graticule, which
        REQ-UI-081 keeps out of the theme's reach, and light text on a dark plot is what stays
        readable there whatever the rest of the window is doing.
    -->
    <SolidColorBrush x:Key="OpenVSA.Chrome.OverlayBackground" Color="#CC1E1E24" />
    <SolidColorBrush x:Key="OpenVSA.Chrome.OverlayForeground" Color="#FFE6E6EA" />

</ResourceDictionary>
