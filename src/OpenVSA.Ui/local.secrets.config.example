<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to local.secrets.config and put your own Syncfusion licence key in it.

  local.secrets.config is git-ignored and MUST stay that way: the key is a per-developer
  credential and this is a public repository. A free Community licence key is available from
  Syncfusion for qualifying individuals and organisations.

  App.config merges this file into appSettings through its file attribute, and ignores it
  silently when it is absent — so a fresh clone builds and runs without one, in trial mode.

  The SYNCFUSION_LICENSE_KEY environment variable takes precedence over this file if both are
  present.

  This is a bare appSettings block, not a full configuration document: the file attribute
  expects appSettings as the root element.
-->
<appSettings>
  <add key="SyncfusionLicenseKey" value="PUT-YOUR-OWN-SYNCFUSION-LICENSE-KEY-HERE" />
</appSettings>
