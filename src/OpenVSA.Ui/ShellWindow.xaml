<Window x:Class="OpenVSA.Ui.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:rendering="clr-namespace:OpenVSA.Ui.Rendering"
        xmlns:layout="clr-namespace:OpenVSA.Ui.Layout"
        Title="OpenVSA" Height="720" Width="1280"
        Background="{DynamicResource OpenVSA.Chrome.WindowBackground}"
        Foreground="{DynamicResource OpenVSA.Chrome.WindowForeground}">

    <!--
        Shell anatomy, per REQ-UI-001, top to bottom:
            title bar -> menu bar -> toolbar band -> document area (trace tab groups, with
            tool windows docked around its edges) -> status bar.

        There is deliberately NO right-hand softkey column. That belongs to the benchtop
        analysers this product line grew out of, not to the software, and adding one would be a
        retro affectation.

        (The model number that used to appear in this comment was removed rather than exempted:
        REQ-HAL-002's criterion is that a code search for instrument names in this assembly
        returns no matches, and an exemption list is how such a search stops meaning anything.)

        Menu names follow the modern (PathWave) bar of REQ-UI-060, not the Agilent-era one:
            File | Edit | Hardware | Acquisition | Analysis | Trace | Marker | Utilities | Window | Help
    -->
    <Window.Resources>
        <!--
            NOT HERE: the menu popup highlight. Measured at #474747 where the theme asks for
            #0078D4, and two cheap routes were tried and BOTH failed, so neither should be tried
            again without reading this:

              - registering the accent with the skin (ThemeCatalogue.RegisterAccent) reaches
                toolbars and selections but not menus - Fluent highlights a menu from its neutral
                ramp by design, where VS Code uses the accent;
              - a Style with an IsHighlighted trigger, BasedOn the skin's own style, changed
                nothing: the skin's MenuItem ControlTemplate paints its highlight internally and
                does not bind Background, which is the same finding #420 recorded for the stock
                templates.

            What is left is owning the MenuItem template - submenus, icons, check marks and
            input-gesture text - which is a real surface to own for ever and is recorded on #420
            rather than done quietly here.
        -->

        <!--
            A toolbar toggle that is on. The skin paints it in the solid accent, which is right for
            a selected menu item and wrong here: Pointer / Area Select / Marker / Band Power are a
            mode group, and one of them is always on, so the band ends up carrying a permanent blue
            block that competes with everything else in it. VS Code marks an active option with a
            translucent accent over the toolbar instead.

            A trigger BasedOn the skin's style was tried first and did nothing, for the third time
            in this file: the skin's ToggleButton template paints its checked fill internally and
            does not bind Background. So this is the second template the shell owns, and like the
            tab header it is deliberately tiny - a border and the content. These toggles carry text,
            never an icon, so there is nothing else in them to lose.

            Asked for by key on each control in ShellToolbarBuilder. ToolBar.ToggleButtonStyleKey
            is the documented route and does NOT work: the skin assigns its own style to the
            toolbar's children, which beats the ToolBar's key lookup.
        -->
        <Style x:Key="OpenVSA.ToolbarToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{DynamicResource OpenVSA.Chrome.ToolbarBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVSA.Chrome.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVSA.Chrome.WindowForeground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Shape"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover first, so that checked still wins while the pointer is over it. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background"
                                        Value="{DynamicResource OpenVSA.Chrome.SurfaceBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background"
                                        Value="{DynamicResource OpenVSA.Chrome.ActiveBackground}" />
                                <Setter TargetName="Shape" Property="BorderBrush"
                                        Value="{DynamicResource OpenVSA.Chrome.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource OpenVSA.Chrome.DisabledForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The document tab strip. DockingManager's own TabItemBackgroundSelected does not reach
            it - measured: the strip went dark and the selected tab stayed Aero blue - because the
            document tabs are a TabControlExt with its own brushes. SETTERS ONLY, and deliberately
            no ControlTemplate: replacing the template is what loses the hosted documents, and the
            whole point of colouring the chrome this way rather than skinning it is to leave every
            template alone.
        -->
        <Style x:Key="OpenVSA.DocumentTabs" TargetType="{x:Type syncfusion:TabControlExt}">
            <Setter Property="Background" Value="{DynamicResource OpenVSA.Chrome.WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVSA.Chrome.MutedForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVSA.Chrome.Border}" />
            <Setter Property="TabPanelBackground" Value="{DynamicResource OpenVSA.Chrome.WindowBackground}" />
            <Setter Property="TabItemSelectedBackground" Value="{DynamicResource OpenVSA.Chrome.SurfaceBackground}" />
            <Setter Property="TabItemSelectedForeground" Value="{DynamicResource OpenVSA.Chrome.WindowForeground}" />
            <Setter Property="TabItemSelectedBorderBrush" Value="{DynamicResource OpenVSA.Chrome.Accent}" />
            <Setter Property="TabItemHoverBackground" Value="{DynamicResource OpenVSA.Chrome.SurfaceBackground}" />
            <Setter Property="TabItemHoverForeground" Value="{DynamicResource OpenVSA.Chrome.WindowForeground}" />
            <Setter Property="TabItemHoverBorderBrush" Value="{DynamicResource OpenVSA.Chrome.Border}" />
        </Style>

        <!--
            The document tab header, and the ONE template this shell owns.

            Every brush above binds correctly and the tab went on painting an Aero gradient anyway:
            TabItemExt hard-codes its selected fill inside its own ControlTemplate, which is exactly
            what #420 measured for ListBoxItem, TabItem and MenuItem. A colour setter cannot reach
            inside a template, so for this one control there is nothing to set - it has to be
            replaced.

            Kept as small as it can be: a border, a top rule and the header. It is the tab HEADER
            only; the document content is hosted elsewhere and is untouched, which is why this is
            safe where re-templating the docking manager is not. The top rule in the accent colour
            is VS Code's tab.activeBorderTop, which is how Dark Modern marks the active tab.
        -->
        <Style x:Key="OpenVSA.DocumentTabItem" TargetType="{x:Type syncfusion:TabItemExt}">
            <Setter Property="Background" Value="{DynamicResource OpenVSA.Chrome.WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVSA.Chrome.MutedForeground}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type syncfusion:TabItemExt}">
                        <!--
                            No BorderBrush at rest, and no thickness either. Naming a colour here
                            (even Transparent) is what REQ-UI-083's hard-coded-colour rule exists
                            to stop; an unselected tab simply has no top rule to colour.
                        -->
                        <Border x:Name="Shape"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter x:Name="Header"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shape" Property="Background"
                                        Value="{DynamicResource OpenVSA.Chrome.SurfaceBackground}" />
                                <Setter TargetName="Shape" Property="BorderThickness" Value="0,2,0,0" />
                                <Setter TargetName="Shape" Property="BorderBrush"
                                        Value="{DynamicResource OpenVSA.Chrome.Accent}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource OpenVSA.Chrome.WindowForeground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background"
                                        Value="{DynamicResource OpenVSA.Chrome.SurfaceBackground}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource OpenVSA.Chrome.WindowForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Named so REQ-NFR-007a's content scaling has something to scale: Ctrl+plus and Ctrl+minus
        put a transform on the whole shell rather than changing a font size, so everything grows
        together and nothing is left behind at the old size.
    -->
    <DockPanel x:Name="Root">

        <!--
            REQ-UI-061's contents: about a hundred items across the ten menus, built in code from
            ShellMenuTable rather than written out here.

            Not a matter of taste. The requirement's criterion is exact in both directions - every
            listed item present, and nothing present that is not listed - so a second hand-kept copy
            of the list in markup is a second thing to drift, and drift that looks right in both
            halves until somebody compares them. The table is the list; the bar is built from it;
            two tests hold the table against the specification and the bar against the table.

            Each item is either bound by the shell or disabled with a reason in the table, and
            building throws if an item is neither - "none is present and inert", enforced while the
            window is being constructed rather than discovered by a user.
        -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top"
              Background="{DynamicResource OpenVSA.Chrome.MenuBackground}"
              Foreground="{DynamicResource OpenVSA.Chrome.MenuForeground}" />

        <!--
            REQ-UI-063's six toolbars, built in code from ShellToolbars for the reason the menus
            are: the contents are the requirement, and a second hand-kept copy here would be a
            second thing to drift. A control that is neither bound nor given a reason throws while
            the window is being built.
        -->
        <ToolBarTray x:Name="Toolbars" DockPanel.Dock="Top"
                     Background="{DynamicResource OpenVSA.Chrome.ToolbarBackground}" />

        <!--
            REQ-UI-006: measurement status messages sit specifically at the bottom left.
            OpenVSA adds dropped-frame count (REQ-NFR-012) and measured front-end transfer
            rate / duty cycle (REQ-NFR-027) to the reference product's status bar contents.
        -->
        <!--
            REQ-UI-006's fields, in order. StatusText is FIRST and therefore leftmost, which is the
            requirement rather than a layout preference: "measurement status messages specifically
            at the bottom left" is quoted from the reference product, and a test asserts the
            position rather than only the presence.
        -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource OpenVSA.Chrome.StatusBarBackground}"
                   Foreground="{DynamicResource OpenVSA.Chrome.StatusBarForeground}">
            <StatusBarItem x:Name="StatusText" Content="Ready" />
            <Separator />
            <StatusBarItem x:Name="CalibrationText" />
            <Separator />
            <StatusBarItem x:Name="ReferenceText" />
            <Separator />
            <StatusBarItem x:Name="RateText" />
            <Separator />
            <StatusBarItem x:Name="TransferText" />
            <Separator />
            <StatusBarItem x:Name="DroppedText" />
            <Separator />
            <StatusBarItem x:Name="PreviewText" />
        </StatusBar>

        <!--
            Document area. The plot surface and hot-spot framework land here in Phase 0; until
            then it reports what the front-end registry found, which is the visible half of
            REQ-NFR-032 - the application starts with no hardware and says what is available
            and what is not, rather than failing or silently offering nothing.
        -->
        <!--
            Document area. Syncfusion DockingManager provides the tool-window/document-container
            arrangement of REQ-UI-001: trace windows as documents, tool windows docked around
            them. This is generic shell furniture and not where the clone earns its keep, which
            is exactly why it is bought rather than built - see DEPENDENCIES.md.

            The plot surface itself is NOT a chart control. Trace geometry is drawn by the
            software rasteriser in Rendering\, because REQ-NFR-006's decimation and REQ-UI-042's
            hot-spot framework have to be ours either way.
        -->
        <!--
            The pane captions and document tabs are Syncfusion's own chrome, and they are coloured
            HERE rather than by a skin. Skinning the DockingManager themes them and costs the
            documents: the trace plot survives as a 0x0 element with no visual parent above the
            fifth level, drawing nothing, with nothing thrown and the tab still on screen. These
            brush properties reach the same pixels through the control's public surface, leave its
            template alone, and - being DynamicResource - follow a theme change with no restart,
            which SetTheme does not. SkinnedShellTests guards the plot; ChromeTheming tests guard
            these.
        -->
        <syncfusion:DockingManager x:Name="Docking" UseDocumentContainer="True"
                                   Background="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   HeaderBackground="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   HeaderForeground="{DynamicResource OpenVSA.Chrome.MutedForeground}"
                                   HeaderForegroundSelected="{DynamicResource OpenVSA.Chrome.WindowForeground}"
                                   SelectedHeaderBackground="{DynamicResource OpenVSA.Chrome.SurfaceBackground}"
                                   HeaderMouseOverBackground="{DynamicResource OpenVSA.Chrome.SurfaceBackground}"
                                   HeaderBorderBrush="{DynamicResource OpenVSA.Chrome.Border}"
                                   TabPanelBackground="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   TabPanelBorderBrush="{DynamicResource OpenVSA.Chrome.Border}"
                                   TabItemsBackground="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   TabItemsBorderBrush="{DynamicResource OpenVSA.Chrome.Border}"
                                   TabItemBackgroundSelected="{DynamicResource OpenVSA.Chrome.SurfaceBackground}"
                                   SplitterBackground="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   SidePanelBackground="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   SidePanelBorderBrush="{DynamicResource OpenVSA.Chrome.Border}"
                                   SideItemsBackground="{DynamicResource OpenVSA.Chrome.WindowBackground}"
                                   SideItemsBorderBrush="{DynamicResource OpenVSA.Chrome.Border}"
                                   PreviewPanelBackground="{DynamicResource OpenVSA.Chrome.Accent}"
                                   TabControlStyle="{StaticResource OpenVSA.DocumentTabs}">

            <!--
                REQ-HAL-002, and the visible half of it: every limit these controls enforce comes
                from IFrontEndCapabilities, and selecting a different source re-ranges them. There
                is no instrument-specific conditional here and no default that a particular model
                would have made right.
            -->
            <ScrollViewer x:Name="MeasurementPane"
                          syncfusion:DockingManager.Header="Measurement"
                          syncfusion:DockingManager.SideInDockedMode="Left">
                <Grid Margin="12" IsEnabled="False" x:Name="SettingsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Centre" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="CentreBox" Margin="0,4" AutomationProperties.AutomationId="Centre"
                             KeyDown="OnSettingKeyDown" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CentreRange" FontSize="10"
                               Foreground="{DynamicResource OpenVSA.Chrome.MutedForeground}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Span" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SpanBox" Margin="0,4" AutomationProperties.AutomationId="Span"
                             KeyDown="OnSettingKeyDown" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SpanRange" FontSize="10"
                               Foreground="{DynamicResource OpenVSA.Chrome.MutedForeground}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ref level" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="ReferenceLevelBox" Margin="0,4" AutomationProperties.AutomationId="ReferenceLevel"
                             KeyDown="OnSettingKeyDown" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ReferenceLevelRange" FontSize="10"
                               Foreground="{DynamicResource OpenVSA.Chrome.MutedForeground}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!--
                      REQ-DSP-012: in zero span this row is the Channel Filter Shape's. The two
                      controls share the cell and only the applicable one is in the grid at all -
                      the other is removed, not hidden, because the requirement asks for no
                      window-type selection to remain REACHABLE.
                    -->
                    <TextBlock Grid.Row="6" Grid.Column="0" x:Name="WindowLabel" Text="Window" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="WindowBox" Margin="0,4,0,8" AutomationProperties.AutomationId="Window" />
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ChannelFilterBox" Margin="0,4,0,8"
                              AutomationProperties.AutomationId="ChannelFilterShape"
                              SelectionChanged="OnChannelFilterSelectionChanged" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Points" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="PointsBox" Margin="0,4" AutomationProperties.AutomationId="Points"
                              SelectionChanged="OnPointsSelectionChanged" />
                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="PointsRange" FontSize="10"
                               Foreground="{DynamicResource OpenVSA.Chrome.MutedForeground}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Res BW" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="ResolutionBandwidthBox" Margin="0,4" AutomationProperties.AutomationId="ResolutionBandwidth"
                             IsEnabled="False" KeyDown="OnSettingKeyDown" />
                    <TextBlock Grid.Row="10" Grid.Column="1" x:Name="ResolutionBandwidthNote" FontSize="10"
                               Foreground="{DynamicResource OpenVSA.Chrome.MutedForeground}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!--
                        REQ-TRG-001: the styles offered are exactly the ones the connected front
                        end declares. The rest stay in the list, greyed, with a tooltip saying why
                        - a style that simply vanished would leave the user wondering whether the
                        software has one at all.
                    -->
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Trigger" Margin="0,4,8,4"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="11" Grid.Column="1" x:Name="TriggerBox" Margin="0,4" AutomationProperties.AutomationId="Trigger"
                              SelectionChanged="OnTriggerSelectionChanged" />
                    <TextBlock Grid.Row="12" Grid.Column="1" x:Name="TriggerNote" FontSize="10"
                               Foreground="{DynamicResource OpenVSA.Chrome.MutedForeground}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ApplyButton" AutomationProperties.AutomationId="Apply" Content="_Apply" Click="OnApplySettings"
                                    Padding="12,3" HorizontalAlignment="Left" />
                            <!--
                                REQ-ACQ-004. Disabled, with the reason as its tooltip, against a
                                source that cannot be ranged - a button that is present, enabled and
                                inert would leave the user believing the range had been set.
                            -->
                            <Button x:Name="AutoRangeButton" AutomationProperties.AutomationId="AutoRange"
                                    Content="Auto _range" Click="OnAutoRange"
                                    Padding="12,3" Margin="8,0,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock x:Name="SettingsMessage" Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontSize="11" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="HardwarePane" syncfusion:DockingManager.Header="Hardware"
                          syncfusion:DockingManager.SideInDockedMode="Left">
                <StackPanel Margin="12">
                    <TextBlock x:Name="DiscoveryHeading" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ProviderList" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="FailureHeading" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl x:Name="FailureList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CapabilitiesText" Margin="0,16,0,0" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="11" />

                    <!--
                        REQ-HAL-001: negotiation is only half the requirement. What the front end
                        coerced, and why, has to be visible - a span silently reduced to what the
                        hardware can manage is a measurement the user will read as if they had got
                        what they asked for.
                    -->
                    <TextBlock x:Name="PlanText" Margin="0,16,0,0" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="11" />

                    <!--
                        REQ-ARC-003: where a measurement personality's readings appear. A
                        personality returns names, values and units and no formatting; the
                        arrangement of them is PersonalityResults', and is asserted without a
                        window.
                    -->
                    <TextBlock x:Name="ResultsHeading" Margin="0,16,0,0" TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <ItemsControl x:Name="ResultsList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ContentControl syncfusion:DockingManager.Header="Trace 1"
                            syncfusion:DockingManager.State="Document">
                <Grid>
                    <!--
                        REQ-UI-005's arrangement lives here. The document area places each trace
                        window at the rectangle TraceLayoutEngine gave it, so what is on screen is
                        the same thing the layout tests assert about - rather than a second
                        arrangement expressed in Grid rows that would have to be kept in agreement.

                        The plot below is handed to it as trace A, which keeps the measurement
                        pipeline, hot spots and marker wiring working unchanged.
                    -->
                    <layout:TraceDocumentArea x:Name="Documents" />

                    <!--
                        The rasterised image fills the control and is hit-testable, so a click
                        anywhere over the trace bubbles to here; the plot converts it to a point
                        index. No Background is set: the palette owns that (REQ-UI-010).
                    -->
                    <rendering:TracePlot x:Name="Plot" MouseLeftButtonDown="OnPlotClicked" />

                    <!--
                        Shown until a source is selected and started, and hidden thereafter. The
                        plot draws its own empty graticule, so this sits over it rather than
                        replacing it.
                    -->
                    <!--
                        Aligned to the top rather than centred. Once the document area holds more
                        than one trace window, a centred overlay lands across the middle of the
                        arrangement and reads as though it belonged to whichever trace it happened
                        to cover - it does not belong to any of them, it is guidance about the
                        measurement as a whole.
                    -->
                    <Border x:Name="DocumentPlaceholderPanel"
                            Background="{DynamicResource OpenVSA.Chrome.OverlayBackground}"
                            CornerRadius="3"
                            Padding="14,8" Margin="0,0,0,18"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="DocumentPlaceholder"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OpenVSA.Chrome.OverlayForeground}"
                                   TextAlignment="Center" MaxWidth="420" />
                    </Border>
                </Grid>
            </ContentControl>

        </syncfusion:DockingManager>

    </DockPanel>
</Window>
