<Window x:Class="OpenVSA.Ui.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenVSA" Height="720" Width="1280">

    <!--
        Shell anatomy, per REQ-UI-001, top to bottom:
            title bar -> menu bar -> toolbar band -> document area (trace tab groups, with
            tool windows docked around its edges) -> status bar.

        There is deliberately NO right-hand softkey column. That belongs to the 89400-series
        hardware, not the software, and adding one would be a retro affectation.

        Menu names follow the modern (PathWave) bar of REQ-UI-060, not the Agilent-era one:
            File | Edit | Hardware | Acquisition | Analysis | Trace | Marker | Utilities | Window | Help
    -->
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" />
            <MenuItem Header="_Edit" />
            <MenuItem x:Name="HardwareMenu" Header="_Hardware" />
            <MenuItem Header="_Acquisition" />
            <MenuItem Header="Ana_lysis" />
            <MenuItem Header="_Trace" />
            <MenuItem Header="_Marker" />
            <MenuItem Header="_Utilities" />
            <MenuItem Header="_Window" />
            <MenuItem Header="_Help" />
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0" />
        </ToolBarTray>

        <!--
            REQ-UI-006: measurement status messages sit specifically at the bottom left.
            OpenVSA adds dropped-frame count (REQ-NFR-012) and measured front-end transfer
            rate / duty cycle (REQ-NFR-027) to the reference product's status bar contents.
        -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" Content="Ready" />
        </StatusBar>

        <!--
            Document area. The plot surface and hot-spot framework land here in Phase 0; until
            then it reports what the front-end registry found, which is the visible half of
            REQ-NFR-032 - the application starts with no hardware and says what is available
            and what is not, rather than failing or silently offering nothing.
        -->
        <ScrollViewer>
            <StackPanel Margin="16">
                <TextBlock x:Name="DiscoveryHeading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl x:Name="ProviderList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="FailureHeading" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl x:Name="FailureList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CapabilitiesText" Margin="0,16,0,0" TextWrapping="Wrap"
                           FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
