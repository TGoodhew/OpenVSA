<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenVSA.Hal</RootNamespace>
    <AssemblyTitle>OpenVSA.Hal</AssemblyTitle>
    <Description>L1 front-end abstraction. The ONLY assembly below L3 that the DSP and measurement layers may reference (REQ-ARC-001). Contains contracts only — no transport, no instrument knowledge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVSA.Core\OpenVSA.Core.csproj" />
  </ItemGroup>

  <!--
    Lets the test project exercise AssemblyTypes directly. The ReflectionTypeLoadException
    salvage path is what keeps REQ-NFR-032 working on a machine with no VISA installed, and it
    cannot be reached by loading a real assembly in a test — so the rule is tested against a
    constructed exception instead, which needs the helper visible.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenVSA.Hal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
