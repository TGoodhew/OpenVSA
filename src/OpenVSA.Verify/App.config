<?xml version="1.0" encoding="utf-8"?>
<!--
  REQ-NFR-001: gcAllowVeryLargeObjects is a runtime *startup* setting, applied per process and not
  per AppDomain, so it cannot be turned on by a test after the host has started. The unit suite
  therefore cannot demonstrate the ceiling itself — it fails with "array dimensions exceeded
  supported range" in the vstest host no matter how the product is configured.

  This harness is configured the way the shipped application is, and carries a
  "check-large-array" switch so the capability is exercised in a process where it is in force.
  The architecture test drives it and reads the exit code.

  (The switch is spelled without its leading dashes above because an XML comment may not contain
  two consecutive hyphens.)
-->
<configuration>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
</configuration>
