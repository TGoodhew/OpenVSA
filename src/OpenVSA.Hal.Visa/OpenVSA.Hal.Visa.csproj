<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenVSA.Hal.Visa</RootNamespace>
    <AssemblyTitle>OpenVSA.Hal.Visa</AssemblyTitle>
    <Description>L0 VISA transport and instrument drivers, including the Agilent E4406A.</Description>
  </PropertyGroup>

  <!--
    REQ-VISA-001: reference Ivi.Visa.dll ALONE (the IVI Foundation VISA.NET Shared Components)
    and open every session through Ivi.Visa.GlobalResourceManager. Direct references to
    NationalInstruments.Visa.dll or Keysight.Visa.dll are PROHIBITED — they hard-bind the
    binary to one vendor and make REQ-VISA-002 unachievable. VISA-COM must not be used.

    Taken as the IVI Foundation's own NuGet package rather than as a path reference to the
    installed Shared Components, so the build does not depend on VISA being installed on the
    build agent. The package carries Ivi.Visa.dll alone; the vendor's native VISA runtime is a
    deployment-time dependency, and its absence is what REQ-NFR-032 requires be survivable.
  -->
  <ItemGroup>
    <PackageReference Include="IviFoundation.Visa" Version="8.0.2" />
  </ItemGroup>

  <!-- VisaConfiguration reads the resource name from appSettings. -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVSA.Core\OpenVSA.Core.csproj" />
    <ProjectReference Include="..\OpenVSA.Hal\OpenVSA.Hal.csproj" />
  </ItemGroup>

</Project>
