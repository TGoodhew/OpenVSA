<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenVSA.Dsp</RootNamespace>
    <AssemblyTitle>OpenVSA.Dsp</AssemblyTitle>
    <Description>L3 analysis core: FFT providers, window functions, resampling, filtering, averaging, statistics and gating.</Description>
  </PropertyGroup>

  <!--
    REQ-ARC-001: this assembly must NOT reference OpenVSA.Hal.Visa, .File or .Sim.
    It consumes IqBlock values only and cannot tell a live instrument from a file or simulator.
    OpenVSA.Architecture.Tests enforces this.
  -->
  <ItemGroup>
    <ProjectReference Include="..\OpenVSA.Core\OpenVSA.Core.csproj" />
  </ItemGroup>

  <!--
    REQ-NFR-004 requires the active FFT provider to be selectable by configuration rather than by
    recompiling, so FftProviders reads appSettings.
  -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <!--
    REQ-NFR-004's native provider. Built by src\OpenVSA.Dsp.Native and copied beside this assembly
    so the P/Invoke resolves with no deployment step.

    Not a ProjectReference: a .vcxproj referenced from a C# project makes MSBuild try to resolve an
    assembly from it, and there is none. The dependency is expressed as a build ordering plus a
    copied file, which is what a native dependency actually is.

    ContinueOnError, because REQ-NFR-004 makes the native provider optional: a machine with no C++
    toolchain still builds the product and runs on the managed default, registering one provider
    instead of two.
  -->
  <!--
    REQ-NFR-003's vector kernels. System.Numerics.Vectors carries Vector<float> on .NET Framework;
    without it the type resolves to the non-accelerated fallback in mscorlib and every measurement
    would compare scalar code against scalar code wearing a vector's name.
  -->
  <ItemGroup>
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OpenVsaNativeFft>$(MSBuildThisFileDirectory)..\OpenVSA.Dsp.Native\bin\x64\$(Configuration)\OpenVSA.Fft.Native.dll</OpenVsaNativeFft>
  </PropertyGroup>

  <!--
    Full MSBuild only. The dotnet CLI's MSBuild has no C++ targets, so evaluating a .vcxproj under
    it fails with MSB4278 before any of this runs. That is also why OpenVSA.Dsp.Native is not in
    OpenVSA.slnx: "dotnet test OpenVSA.slnx" evaluates every project in the solution, C++ or not.
    The native library is built here, by the full-MSBuild build that precedes the tests.
  -->
  <Target Name="BuildNativeFft" BeforeTargets="BeforeBuild"
          Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\OpenVSA.Dsp.Native\OpenVSA.Dsp.Native.vcxproj"
             Properties="Configuration=$(Configuration);Platform=x64"
             ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <!--
      Conditioned on the runtime, NOT on Exists(). Item conditions are evaluated before any target
      runs, so on a clean checkout Exists() is false at evaluation time, because BuildNativeFft has
      not produced the library yet. The item is dropped and the copy silently never happens. That
      is what made CI report "Unable to load DLL OpenVSA.Fft.Native.dll" from a build that had
      compiled it moments earlier.

      Under full MSBuild the item is always present and BuildNativeFft has run by the time the copy
      does. Under the dotnet CLI the native project cannot be built at all, so the item is absent
      and the managed default carries the product.
    -->
    <Content Include="$(OpenVsaNativeFft)" Condition="'$(MSBuildRuntimeType)' != 'Core'">
      <Link>OpenVSA.Fft.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
