<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenVSA.Measurement.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenVSA.Measurement\OpenVSA.Measurement.csproj" />

    <!--
      REQ-LIM-003 is a criterion about the automation API, so the tests for it need it. A test-only
      reference; nothing in OpenVSA.Measurement references OpenVSA.Api, which sits above it.
    -->
    <ProjectReference Include="..\..\src\OpenVSA.Api\OpenVSA.Api.csproj" />

    <!--
      The modulated generator of REQ-SIM-001. It carries no transport, so referencing it keeps
      REQ-ARC-001's "the analysis stack builds with every real transport removed" true, which the
      same reference to OpenVSA.TestHarness did not, because the harness drives a bench.
    -->
    <ProjectReference Include="..\..\src\OpenVSA.Synthesis\OpenVSA.Synthesis.csproj" />
  </ItemGroup>

</Project>
