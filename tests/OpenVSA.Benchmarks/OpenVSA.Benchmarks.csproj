<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenVSA.Benchmarks</RootNamespace>
    <AssemblyName>OpenVSA.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>

    <!--
      Not a test project, despite living under tests\. IsTestProject would have `dotnet test`
      try to run it, and the shared test App.config pins a System.Runtime.CompilerServices.Unsafe
      redirect that conflicts with the newer one Syncfusion brings in through OpenVSA.Ui.
    -->
    <IsTestProject>false</IsTestProject>
    <AppConfig />
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    The performance gates of REQ-NFR-020 to REQ-NFR-026. Not a test project: BenchmarkDotNet
    needs a Release-built executable it can launch as its own child process, and running it
    under the xUnit host would measure the host.
  -->
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- REQ-NFR-025 drives the real shell through UI Automation rather than constructing it. -->
  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenVSA.Dsp\OpenVSA.Dsp.csproj" />
    <ProjectReference Include="..\..\src\OpenVSA.Ui\OpenVSA.Ui.csproj" />
    <ProjectReference Include="..\OpenVSA.PerformanceGate\OpenVSA.PerformanceGate.csproj" />
  </ItemGroup>

</Project>
